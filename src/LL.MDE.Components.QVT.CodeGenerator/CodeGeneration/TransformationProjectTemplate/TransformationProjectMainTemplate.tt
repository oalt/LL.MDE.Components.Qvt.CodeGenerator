<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="LL.MDE.Components.Qvt.Metamodel.QVTRelation" #>
<#@ import namespace="LL.MDE.Components.Qvt.Metamodel.QVTBase" #>
<#@ import namespace="LL.MDE.Components.Qvt.Metamodel.EMOF" #>
<#@ import namespace="LL.MDE.Components.Qvt.Metamodel.CustomExtensions.EMOFExtensions" #>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LL.MDE.Components.Qvt.Common\src\LL.MDE.Components.Qvt.Common-dev.csproj" />
    <ProjectReference Include="..\DataModelExtensions\DataModelExtensions.csproj" />
    <ProjectReference Include="..\MDD4All.QVT.DataAccess.Default\src\MDD4All.QVT.DataAccess.Default\MDD4All.QVT.DataAccess.Default-dev.csproj" />
    <ProjectReference <#= "Include=\"..\\" + QvtCodeGeneratorStrings.ConfigurationProjectName(Transformation) + "\\" + QvtCodeGeneratorStrings.ConfigurationProjectName(Transformation) + ".csproj" + "\"" #> />
  </ItemGroup>

  <ItemGroup>
<#
    foreach(IPackage mmPackage in Transformation.GetMetaModelPackagesForTransformation())
    {
        string type = mmPackage.GetTag("ReferenceType")?.Value;
        string packageName = mmPackage.GetTag("PackageName")?.Value;
        string version = mmPackage.GetTag("Version")?.Value;
        string name = mmPackage.GetNamespace();

        if(!string.IsNullOrEmpty(type))
        {
            if(type == "Project")
            {
                
#>
    <ProjectReference <#= "Include=\"..\\" + name + "\\src\\" + name + "\\" + name + "-dev.csproj" + "\"" #> />
<#
            }
            else if(type == "Package")
            {
#>
    <PackageReference Include="<#= packageName #>" Version="<#= version #>" />
<#
            }
            else if(type == "File")
            {
#>
    <Reference Include="<#= name #>">
        <HintPath><#= "..\\libs\\"+  packageName + ".dll" #></HintPath>
        <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
<#
            }
        }

    }
#>
  </ItemGroup>

</Project>